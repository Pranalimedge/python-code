## 1. Print "Jay Ganesh..." every 2 seconds

import schedule
import time

def Display():
    print("Jay Ganesh...")

schedule.every(2).seconds.do(Display)

while True:
    schedule.run_pending()
    time.sleep(1)

## 2. Display current date and time every 1 minute

import schedule
import time
from datetime import datetime

