## 7. Backup a file every hour

import schedule
import time
import shutil
import os
from datetime import datetime

source = input("Enter source file path : ")
destination = input("Enter destination folder path : ")

def Backup():
    filename = os.path.basename(source)
    name, ext = os.path.splitext(filename)

    timestamp = datetime.now().strftime("%d_%m_%Y_%H_%M_%S")
    newfile = f"{name}_{timestamp}{ext}"

    destfile = os.path.join(destination, newfile)

    shutil.copy(source, destfile)

    with open("backup_log.txt", "a") as log:
        log.write(f"Backup completed successfully at {datetime.now().strftime('%d-%m-%Y %I:%M:%S %p')}\n")

    print("Backup Created :", newfile)

schedule.every(1).hours.do(Backup)

while True:
    schedule.run_pending()
    time.sleep(1)
