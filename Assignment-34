        # ----------------------------------------------------------
# Platform Surveillance
# ----------------------------------------------------------
def PlatformSurveillance(FolderName):

    Border = "-" * 60

    try:

        if os.path.exists(FolderName):

            if os.path.isdir(FolderName) == False:

                print("Path exists but it is not directory")
                logging.error("Invalid directory")
                return

        else:

            os.mkdir(FolderName)

            logging.info("Directory created successfully")

        TimeStamp = time.strftime("%Y-%m-%d_%H-%M-%S")

        FileName = os.path.join(
            FolderName,
            "Marvellous_%s.log" % TimeStamp
        )

        with open(FileName, "w") as fobj:

            fobj.write(Border + "\n")
            fobj.write("MARVELLOUS PLATFORM SURVEILLANCE SYSTEM\n")
            fobj.write(Border + "\n")
            fobj.write("Log Created At : " + TimeStamp + "\n")
            fobj.write(Border + "\n\n")

            # CPU Information

            fobj.write("SYSTEM INFORMATION\n")
            fobj.write(Border + "\n")

            fobj.write("CPU Count : %s\n" % psutil.cpu_count())

            fobj.write("CPU Usage : %.2f %%\n" % psutil.cpu_percent())

            Memory = psutil.virtual_memory()

            fobj.write("RAM Usage : %.2f %%\n" % Memory.percent)

            fobj.write("Total RAM : %s Bytes\n" % Memory.total)

            Net = psutil.net_io_counters()

            fobj.write("Bytes Sent : %.2f MB\n" % (Net.bytes_sent/(1024*1024)))

            fobj.write("Bytes Received : %.2f MB\n" % (Net.bytes_recv/(1024*1024)))

            fobj.write(Border + "\n\n")

            # Process Information

            fobj.write("RUNNING PROCESS REPORT\n")
            fobj.write(Border + "\n")

            Data = ProcessScan()

            for Process in Data:

                fobj.write("PID : %s\n" % Process.get("pid"))

                fobj.write("Name : %s\n" % Process.get("name"))

                fobj.write("Username : %s\n" % Process.get("username"))

                fobj.write("Status : %s\n" % Process.get("status"))

                fobj.write("CPU Percentage : %.2f\n" % Process.get("cpu_percent"))

                fobj.write("RAM Percentage : %.2f\n" % Process.get("memory_percent"))

                fobj.write(Border + "\n")

        logging.info("Log file created successfully")

        print("Log File Created :", FileName)

        return FileName

    except Exception as e:

        logging.error(str(e))

        print("Error :", e)

