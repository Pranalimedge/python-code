# Main Function
# ----------------------------------------------------------
def main():

    Border = "-" * 60

    print(Border)
    print("MARVELLOUS PLATFORM SURVEILLANCE SYSTEM")
    print(Border)

    # ------------------------------------------------------
    # Help
    # ------------------------------------------------------

    if len(sys.argv) == 2:

        if sys.argv[1] in ("-h", "--h"):

            print("""Usage :python Automation.py <TimeInterval> <FolderName>""")
            return

        elif sys.argv[1] in ("-u", "--u"):

            print("""Arguments :1 : Time Interval (Minutes) 2 : Folder Name

3 : Search Process 4 : Email Log File""")
            return

        else:

            print("Invalid Argument")
            return

    # ------------------------------------------------------
    # Search Process
    # ------------------------------------------------------

    elif len(sys.argv) == 3:

        if sys.argv[1].lower() == "search":

            SearchProcess(sys.argv[2])

            return

        else:

            try:

                Interval = int(sys.argv[1])

                if Interval <= 0:

                    print("Invalid Time Interval")
                    return

                Folder = sys.argv[2]

                print("Scheduler Started Successfully")

                schedule.every(Interval).minutes.do(
                    PlatformSurveillance,
                    Folder
                )

                while True:

                    schedule.run_pending()

                    time.sleep(1)

            except ValueError:

                print("Time Interval should be Integer")

            except KeyboardInterrupt:

                print("\nScheduler Stopped")

            except Exception as e:

                logging.error(str(e))

                print(e)

    # ------------------------------------------------------
    # Email Option
    # ------------------------------------------------------

    elif len(sys.argv) == 4:

        if sys.argv[1].lower() == "email":

            Folder = sys.argv[2]

            Receiver = sys.argv[3]

            FileName = PlatformSurveillance(Folder)

            if FileName is not None:

                SendMail(Receiver, FileName)

                print("Mail Sent Successfully")

        else:

            print("Invalid Arguments")

    else:
        print("Invalid Number Of Arguments")

    print(Border)
    print("Thank You For Using Automation System")
    print(Border)

if __name__ == "__main__":
    main()
