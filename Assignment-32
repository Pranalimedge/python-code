# 2. Monitor the size of a specified file every 30 seconds

import os
import schedule
import time
from datetime import datetime

path = input("Enter file path: ")

def CheckFileSize():
    with open("FileSizeLog.txt", "a") as log:
        if os.path.exists(path):
            size = os.path.getsize(path)
            log.write(f"File : {path}\n")
            log.write(f"Size : {size} bytes\n")
            log.write(f"Date & Time : {datetime.now()}\n\n")
            print("File size logged.")
        else:
            log.write(f"{path} does not exist. {datetime.now()}\n\n")
            print("File does not exist.")

schedule.every(30).seconds.do(CheckFileSize)

while True:
    schedule.run_pending()
    time.sleep(1)

