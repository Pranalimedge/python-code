## 5. Delete all empty files every hour

import os
import schedule
import time
from datetime import datetime

directory = input("Enter directory path: ")

def DeleteEmptyFiles():
    with open("DeleteLog.txt", "a") as log:
        for root, dirs, files in os.walk(directory):
            for file in files:
                filepath = os.path.join(root, file)

                try:
                    if os.path.getsize(filepath) == 0:
                        os.remove(filepath)
                        log.write(f"Deleted : {filepath} at {datetime.now()}\n")
                        print("Deleted:", filepath)

                except PermissionError:
                    log.write(f"Permission denied : {filepath}\n")
                except Exception as e:
                    log.write(f"Error : {filepath} : {e}\n")

schedule.every(1).hours.do(DeleteEmptyFiles)

while True:
    schedule.run_pending()
    time.sleep(1)
