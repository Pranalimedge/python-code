import math
# =====================================================
# ASSIGNMENT 1 : MANUAL KNN
# =====================================================

print("=" * 40)
print("ASSIGNMENT 1 : MANUAL KNN")
print("=" * 40)

# Dataset
data = [
    [1, 2, "Red"],
    [2, 3, "Red"],
    [3, 1, "Blue"],
    [6, 5, "Blue"]
]

x = float(input("Enter X coordinate: "))
y = float(input("Enter Y coordinate: "))

# Calculate distances
distances = []

for point in data:
    d = math.sqrt((x - point[0]) ** 2 + (y - point[1]) ** 2)
    distances.append([d, point[2]])

# Sort distances
distances.sort()

# K = 3
print("\nNearest Neighbors:")

for i in range(3):
    print(
        data[i] if False else
        "Distance:", round(distances[i][0], 2),
        "Class:", distances[i][1]
    )

# Majority voting
red = 0
blue = 0

for i in range(3):
    if distances[i][1] == "Red":
        red += 1
    else:
        blue += 1

if red > blue:
    result = "Red"
else:
    result = "Blue"

print("\nPredicted Class:", result)


