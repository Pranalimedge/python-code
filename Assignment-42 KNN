# =====================================================
# ASSIGNMENT 3 : STUDENT PASS / FAIL
# =====================================================

print("\n")
print("=" * 40)
print("ASSIGNMENT 3 : STUDENT PASS / FAIL")
print("=" * 40)

# Dataset
students = [
    [2, 60, "Fail"],
    [5, 80, "Pass"],
    [6, 85, "Pass"],
    [1, 50, "Fail"]
]

study = float(input("Enter Study Hours: "))
attendance = float(input("Enter Attendance: "))

distances = []

# Calculate distance
for student in students:

    d = math.sqrt(
        (study - student[0]) ** 2 +
        (attendance - student[1]) ** 2
    )

    distances.append([d, student[2]])

# Sort
distances.sort()

# K = 3
passed = 0
failed = 0

for i in range(3):

    if distances[i][1] == "Pass":
        passed += 1
    else:
        failed += 1

# Prediction
if passed > failed:
    result = "Pass"
else:
    result = "Fail"

print("\nPredicted Result:", result)
